```
# Java/Maven build artifacts
target/
*.class

# Dependencies
lib/
!lib/**/*

# IDE specific
.idea/
*.iml
*.ipr
*.iws

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log

