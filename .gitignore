.env
.env.local
.env.*

# Test coverage
coverage/
*.gcov
*.lcov
*.profdata

# Maven wrapper (if present)
.mvn/wrapper/

# Local Maven repository (if checked in accidentally)
repository/

# Compiled native extensions (if any)
*.so
*.dll
*.dylib

# Package distributions
*.jar
*.war
*.ear
```